-fn connected_here() -> Vec<String> {
+/// Windows: names of the devices paired with this PC and connected to it now for audio (classic
+/// Bluetooth). Earbuds like the Wave Beam advertise their control service on BLE under a random
+/// address Windows never pairs, so this list is the only way to tell they are ours.
+#[cfg(windows)]
+async fn connected_here() -> Vec<String> {
+    use windows::Devices::Bluetooth::{BluetoothConnectionStatus, BluetoothDevice};
+    use windows::Devices::Enumeration::DeviceInformation;
+    let run = async {
+        let selector = BluetoothDevice::GetDeviceSelectorFromPairingState(true)?;
+        let mut names = vec![];
+        for info in DeviceInformation::FindAllAsyncAqsFilter(&selector)?.await? {
+            let Ok(device) = BluetoothDevice::FromIdAsync(&info.Id()?)?.await else { continue };
+            if device.ConnectionStatus()? == BluetoothConnectionStatus::Connected {
+                names.push(device.Name()?.to_string());
+            }
+        }
+        windows::core::Result::Ok(names)
+    };
+    run.await.unwrap_or_default()
+}
+
+#[cfg(not(any(target_os = "macos", windows)))]
+async fn connected_here() -> Vec<String> {
     vec![]
 }
 
